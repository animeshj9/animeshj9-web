{
  "name": "animeshj9-lab-subdomains",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./_worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "animeshj9.com", "custom_domain": true },
    { "pattern": "www.animeshj9.com", "custom_domain": true },
    { "pattern": "feedproof.animeshj9.com", "custom_domain": true },
    { "pattern": "galli-club.animeshj9.com", "custom_domain": true },
    { "pattern": "footpath-optional.animeshj9.com", "custom_domain": true },
    { "pattern": "long-arc.animeshj9.com", "custom_domain": true }
  ]
}
